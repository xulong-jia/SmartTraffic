SMARTTRAFFIC_APP_NAME=SmartTraffic 智慧交通事件检测系统
SMARTTRAFFIC_ENV=local
SMARTTRAFFIC_RESULTS_DIR=results/traffic_analysis
SMARTTRAFFIC_LOCAL_VIDEOS_DIR=local_videos
SMARTTRAFFIC_LOCAL_MODELS_DIR=local_models
YOLO_MODEL_PATH=local_models/best.pt
YOLO_CONF_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45
YOLO_IMAGE_SIZE=640
YOLO_DEVICE=cpu
YOLO_DRY_RUN=true
DEEPSORT_DRY_RUN=true
DEEPSORT_MAX_AGE=30
DEEPSORT_N_INIT=1
DEEPSORT_MAX_IOU_DISTANCE=0.7
DEEPSORT_MAX_COSINE_DISTANCE=0.2
TRACKING_MIN_CONFIDENCE=0.0
TRACKING_TARGET_CLASSES=car,bus,truck,motorcycle,bicycle,person
TRACKING_WRITE_PREVIEW=false
VIDEO_FRAME_STRIDE=1
DETECTION_MAX_FRAMES=120
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
